{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kya.dev/schemas/kya-credential.schema.json",
  "title": "KYA Credential Subject",
  "description": "Credential subject of a Know-Your-Agent verifiable credential (spec v0.1.0-draft)",
  "type": "object",
  "required": ["agent", "operator", "runtime", "scopes", "assuranceTier", "validFrom", "validUntil", "revocation"],
  "properties": {
    "agent": {
      "type": "string",
      "pattern": "^did:(key|web|pkh):.+",
      "description": "DID of the agent's signing/session key"
    },
    "operator": {
      "type": "string",
      "pattern": "^did:(key|web):.+",
      "description": "DID of the responsible operator"
    },
    "operatorKYB": {
      "type": "object",
      "required": ["issuer", "level", "checkedAt"],
      "properties": {
        "issuer": { "type": "string", "description": "DID of the KYB issuer" },
        "level": { "enum": ["none", "basic", "full"] },
        "jurisdictionCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["tee", "signed-manifest", "self-attested"] },
        "evidence": { "type": "string", "description": "TEE quote hash or build-manifest hash (hex)" },
        "model": { "type": "string", "description": "Model identifier, e.g. claude-fable-5" },
        "framework": { "type": "string", "description": "Agent framework identifier" }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+(:[a-z0-9-]+)?$" },
      "description": "Authorized activity scopes, category[:qualifier]"
    },
    "policyCommitment": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "description": "keccak256 hash of the enforced policy document"
    },
    "assuranceTier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Derived tier; verifiers MUST recompute from evidence"
    },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "revocation": {
      "type": "object",
      "required": ["method", "registry", "id"],
      "properties": {
        "method": { "enum": ["registry"] },
        "registry": { "type": "string", "description": "chain:address (CAIP-10) or HTTPS status-list URL" },
        "id": { "type": "string" }
      }
    }
  }
}
