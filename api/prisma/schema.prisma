generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityType {
  INDIVIDUAL
  COMPANY
}

enum AgentStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  REVOKED
}

enum CheckType {
  KYB
  SANCTIONS
  ACCREDITATION
}

enum CheckStatus {
  PENDING
  PASSED
  FAILED
}

model Agent {
  id                    String      @id @default(cuid())
  wallet                String      @unique
  erc8004TokenId        String?
  ownerName             String
  ownerEmail            String
  ownerEntityType       EntityType
  jurisdiction          String
  accredited            Boolean     @default(false)
  status                AgentStatus @default(PENDING)
  statusReason          String?
  verificationStage     String      @default("SUBMITTED")
  attestationUID        String?
  attestTxHash          String?
  registerTxHash        String?
  operatorProofMessage  String
  operatorProofSignature String
  operatorProofVerifiedAt DateTime
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  checks      VerificationCheck[]
  auditEvents AuditEvent[]
}

model RegistrationChallenge {
  wallet    String   @id
  nonce     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model VerificationCheck {
  id          String      @id @default(cuid())
  agentId     String
  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type        CheckType
  provider    String
  status      CheckStatus @default(PENDING)
  rawResult   Json?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
}

model AuditEvent {
  id          String   @id @default(cuid())
  agentId     String?
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  type        String
  payload     Json
  chainTxHash String?
  chainLogKey String?  @unique
  createdAt   DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([type, createdAt])
}

model IndexerCursor {
  id        String   @id
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}
